POSTGRES_DB=brand_monitor
POSTGRES_USER=monitor_migrator
POSTGRES_PASSWORD=replace-with-local-password
RUNTIME_DB_PASSWORD=replace-with-runtime-password
MIGRATION_DATABASE_URL=postgresql://monitor_migrator:replace-with-local-password@localhost:5432/brand_monitor
